# OpenDAP developer host tools (macOS). Install with: brew bundle --file=env/Brewfile
# Design applications (KiCad 10, FreeCAD 1.1, Blender 5.2) are installed from their official
# installers; env/setup.sh checks their versions.

# Repository hygiene
brew "git-lfs"
brew "pre-commit"
brew "reuse"
brew "yq"
brew "jq"
brew "gh"
brew "git-filter-repo"   # history-preserving moves for the topology cutover (odw rename merge)

# Python (per-study simulation environments)
brew "uv"

# Electronics simulation
brew "ngspice"

# Firmware: flashing, debugging, serial
brew "probe-rs-tools"
brew "picotool"
brew "dfu-util"
brew "openocd"
brew "tio"
brew "sigrok-cli"

# Rust tooling
brew "cargo-binstall"
# Linker for cross-builds to Blackbird OS against the image's glibc (cargo-zigbuild)
brew "zig"

# Emulation, and the Linux VM that builds images and the sysroot
brew "qemu"
# Building the patched QEMU (bin/odw-qemu); QEMU's own libraries come with brew "qemu"
brew "meson"
brew "ninja"
brew "pkgconf"
brew "lima"
# The LAN for virtual devices (socket_vmnet) is installed by bin/odw-vmnet, not Homebrew

# Motion review and presentation videos: recording, frames, encoding (toolkit-verify odw motion)
brew "ffmpeg"
