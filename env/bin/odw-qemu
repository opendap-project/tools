#!/bin/sh
# QEMU for virtual OpenDAP devices, with the patches OpenDAP carries (virtual-devices ADR 0003).
#
# Usage: odw qemu [install|status] [--dry-run] [--json]   (default: status)
#
# install fetches QEMU's pinned source release, checks its SHA-256, applies qemu/patches/ in order,
# builds the aarch64 system emulator and installs it to ~/.local/opt/opendap/qemu-<version>-<build>,
# then links qemu-system-aarch64 into ~/.local/bin, ahead of Homebrew's on PATH. No administrator
# rights. The build says what it is in its version line (`--with-pkgversion`), which is how
# odap-vdev tells it from a stock QEMU. ODAP_JOBS sets the build's parallelism (default 4: the
# machine is shared). install --dry-run names the download, the build folder and the link, says
# which build tools are missing, and changes nothing.
#
# The patches fix QEMU 11.1's sound for a D-Bus display client: a mono stream through the mixing
# engine is no longer doubled, the input is paced without the mixing engine, and a stream's last
# partial block is sent when the stream stops.
#
# status --json prints opendap.qemu-status/v1 (installed, linked, version, path). Errors carry a
# dotted code, a hint and a fix (with --json, also an opendap.error/v1 document on stdout).
#
# Examples:
#   odw qemu status --json
#   odw qemu install --dry-run
#
# Exit status: 0 success (status: installed and linked), 1 failure (status: not installed),
# 2 usage error.
set -eu

here="$(cd "$(dirname "$0")/.." && pwd)"
CLI_TOOL="odw qemu"
# The shared helpers, in core/ since HL-71.
. "$here/../core/lib/cli.sh"

verb=""; dry=0
for a in "$@"; do
  case "$a" in
    -h|--help|help) cli_help "$0" 26; exit 0 ;;
    --dry-run) dry=1 ;;
    --json) CLI_JSON=1 ;;
    -*) cli_usage "unknown flag $a" ;;
    install|status) [ -z "$verb" ] || cli_usage "one command at a time: $verb, $a"; verb="$a" ;;
    *) cli_usage "unknown command $a (install, status)" ;;
  esac
done
verb="${verb:-status}"

# The pinned release: https://download.qemu.org (the same SHA-256 as Homebrew's formula for 11.1.2).
version=11.1.2
sha256=731b5681e4bb18be313231579b8efd0296c5b015fa36dc533874b639ba838016
# The patch set's name, carried in the version line; change it whenever qemu/patches/ changes.
build=opendap1

prefix="$HOME/.local/opt/opendap/qemu-$version-$build"
link="$HOME/.local/bin/qemu-system-aarch64"
work="${XDG_CACHE_HOME:-$HOME/.cache}/opendap/qemu.noindex"
url="https://download.qemu.org/qemu-$version.tar.xz"
setup_fix="$here/setup.sh"

status() {
  installed=false; linked=false; line=""
  [ -x "$prefix/bin/qemu-system-aarch64" ] && installed=true
  [ "$(readlink "$link" 2>/dev/null)" = "$prefix/bin/qemu-system-aarch64" ] && linked=true
  if [ "$installed" = true ] && [ "$linked" = true ]; then line="$("$link" --version | head -1)"; fi
  if [ "$CLI_JSON" = 1 ]; then
    printf '{"schema": "opendap.qemu-status/v1", "installed": %s, "linked": %s, "version": %s, "path": %s}\n' \
      "$installed" "$linked" "$(cli_json_str "$line")" "$(cli_json_str "$prefix/bin/qemu-system-aarch64")"
  fi
  if [ -n "$line" ]; then
    [ "$CLI_JSON" = 1 ] || echo "$line"
    case ":$PATH:" in
      *":$HOME/.local/bin:"*) ;;
      *) echo "odw qemu: add ~/.local/bin to PATH (before Homebrew) so odap-vdev finds it" >&2 ;;
    esac
    found="$(command -v qemu-system-aarch64 || true)"
    [ "$found" = "$link" ] || echo "odw qemu: qemu-system-aarch64 on PATH is $found, not $link" >&2
    return 0
  fi
  [ "$CLI_JSON" = 1 ] || echo "not installed (odw qemu install)"
  return 1
}

missing_tools() {
  for t in curl shasum tar patch ninja meson pkg-config; do command -v "$t" >/dev/null || echo "$t"; done
}

dry_install() {
  echo "odw qemu: would download $url to $work (SHA-256 $sha256)" >&2
  set -- "$here"/qemu/patches/*.patch
  echo "odw qemu: would apply $# patches from $here/qemu/patches" >&2
  echo "odw qemu: would build with ${ODAP_JOBS:-4} jobs and install to $prefix" >&2
  echo "odw qemu: would link $link" >&2
  miss="$(missing_tools | tr '\n' ' ')"
  [ -z "$miss" ] && return 0
  echo "odw qemu: would fail: missing $miss(run $setup_fix)" >&2
  return 1
}

install() {
  miss="$(missing_tools | tr '\n' ' ')"
  [ -z "$miss" ] || cli_fail "tool.missing" "missing build tools: $miss" "the host setup installs them" "$setup_fix"
  mkdir -p "$work"
  tarball="$work/qemu-$version.tar.xz"
  if [ ! -f "$tarball" ] || ! echo "$sha256  $tarball" | shasum -a 256 -c - >/dev/null 2>&1; then
    curl -fsSL -o "$tarball.part" "$url" ||
      cli_fail "download.failed" "could not download $url" "check the network and the release URL" "curl -I $url"
    echo "$sha256  $tarball.part" | shasum -a 256 -c - >/dev/null ||
      cli_fail "download.checksum" "qemu-$version.tar.xz: SHA-256 mismatch" \
        "the download is not the pinned release; it is kept as $tarball.part" "rm $tarball.part && odw qemu install"
    mv "$tarball.part" "$tarball"
  fi
  src="$work/qemu-$version-$build"
  rm -rf "$src"
  mkdir -p "$src"
  tar -xJf "$tarball" -C "$src" --strip-components 1
  for p in "$here"/qemu/patches/*.patch; do
    patch -d "$src" -p1 --quiet --forward < "$p" ||
      cli_fail "qemu.patch" "$(basename "$p") does not apply to $version" \
        "the patch set and the pinned release disagree" "git -C $here log -- qemu/patches"
  done
  # aarch64 only, with what the virtual devices use: HVF, the D-Bus display and its audio, Cocoa,
  # CoreAudio, user networking. apple-gfx does not build against the macOS 27 SDK and is not used.
  mkdir -p "$src/build"
  (cd "$src/build" && ../configure --prefix="$prefix" --target-list=aarch64-softmmu \
      --with-pkgversion="$build" --enable-hvf --enable-slirp --enable-cocoa --enable-coreaudio \
      --enable-dbus-display --disable-pvg --disable-docs >configure.log 2>&1) ||
    cli_fail "qemu.configure" "configure failed" "its log names the missing dependency" "less $src/build/configure.log"
  (cd "$src/build" && nice ninja -j "${ODAP_JOBS:-4}" install >build.log 2>&1) ||
    cli_fail "qemu.build" "build failed" "its log names the failing step" "less $src/build/build.log"
  mkdir -p "$(dirname "$link")"
  ln -sf "$prefix/bin/qemu-system-aarch64" "$link"
  rm -rf "$src"
  status
}

case "$verb" in
  install) if [ "$dry" = 1 ]; then dry_install; else install; fi ;;
  status) status ;;
esac
