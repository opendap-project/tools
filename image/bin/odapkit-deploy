#!/bin/sh
# Deploy the Cargo workspace's binaries to a running device, without rebuilding the image.
# The workspace is the one in the current directory; they go as a development system extension.
# Usage: odapkit deploy [--debug] [--dry-run] [--json] [crate…]
#   crate   binaries to deploy (default: [workspace.metadata.odap] deploy in Cargo.toml). Naming
#           crates updates only those in the extension and keeps the others; the default list
#           replaces the extension, so a crate dropped from the list leaves the device too.
# Each crate's binaries go to /usr/lib/blackbird/<binary> (RFC 0017 §3: Blackbird OS's internal programs
# carry no prefix; a crate names its binary with [[bin]]). The extension is
# /var/lib/extensions/odap-dev-<workspace>/usr/lib/blackbird/…, merged with
# `systemd-sysext refresh`; the units in [workspace.metadata.odap] restart are restarted.
# `systemd-sysext unmerge` and removing the directory return the device to its image.
# Target: the running virtual device (odap-vdev ssh); ODAP_DEVICE_SSH="ssh …" for another one.
# --dry-run names the crates, the extension, the target and the units to restart, and builds and
# sends nothing. --json prints opendap.deploy/v1 (extension, crates, profile, restart, target, done).
# Examples:
#   odapkit deploy --dry-run
#   odapkit deploy --json blackbird-composer
set -eu
here="$(cd "$(dirname "$0")" && pwd)"
. "$here/../lib/odapkit.sh"
profile=release flag=--release
names=""
for a in "$@"; do
  case "$a" in
    --debug) profile=debug flag= ;;
    -*) cli_flag "$a" ;;
    *) names="$names $a" ;;
  esac
done
# shellcheck disable=SC2086
set -- $names
[ -f Cargo.toml ] || cli_fail "cargo.not_found" "no Cargo.toml in $PWD" "deploy runs in the Cargo workspace it deploys" \
  "cd <cargo workspace> && odapkit deploy" 2
meta() { awk -v key="$1" '/^\[workspace\.metadata\.odap\]/ {f=1; next} /^\[/ {f=0} f && $1 == key { sub(/^[^=]*=[ ]*\[/, ""); sub(/\].*$/, ""); gsub(/[",]/, " "); print }' Cargo.toml; }
crates="${*:-$(meta deploy)}"
keep=0; [ $# -gt 0 ] && keep=1
[ -n "$crates" ] || cli_fail "deploy.no_crates" "no crates given and no [workspace.metadata.odap] deploy list" \
  "name the crates, or list them in Cargo.toml" "odapkit deploy <crate>" 2
restart="$(meta restart)"
name="odap-dev-$(basename "$PWD")"
target="${ODAP_DEVICE_SSH:-odap-vdev ssh}"

result() {
  if [ "$CLI_JSON" = 1 ]; then
    js_list() { sep=""; printf '['; for x in $1; do printf '%s%s' "$sep" "$(cli_json_str "$x")"; sep=", "; done; printf ']'; }
    printf '{"schema": "opendap.deploy/v1", "extension": %s, "crates": %s, "profile": %s, "restart": %s, "target": %s, "done": %s}\n' \
      "$(cli_json_str "$name")" "$(js_list "$crates")" "$(cli_json_str "$profile")" "$(js_list "$restart")" \
      "$(cli_json_str "$target")" "$1"
  fi
}
if [ "$DRY_RUN" = 1 ]; then
  echo "$CLI_TOOL: would build $crates ($profile) with odapkit cross" >&2
  echo "$CLI_TOOL: would install them in /var/lib/extensions/$name on $target and refresh systemd-sysext" >&2
  [ -z "$restart" ] || echo "$CLI_TOOL: would restart $restart" >&2
  result false
  exit 0
fi

pkgs=""; for c in $crates; do pkgs="$pkgs -p $c"; done
# shellcheck disable=SC2086
"$here/odapkit-cross" build $flag $pkgs >&2

stage="$(mktemp -d)"; trap 'rm -rf "$stage"' EXIT
mkdir -p "$stage/usr/lib/blackbird" "$stage/usr/lib/extension-release.d"
# The binaries of the named crates, by their [[bin]] names (cargo metadata).
# shellcheck disable=SC2086
bins="$(cargo metadata --no-deps --format-version 1 | python3 -c 'import json, sys
crates = set(sys.argv[1:])
for p in json.load(sys.stdin)["packages"]:
    if p["name"] in crates:
        print(" ".join(t["name"] for t in p["targets"] if "bin" in t["kind"]))' $crates)" ||
  cli_fail "cargo.metadata" "cargo metadata failed in $PWD" "deploy reads each crate's binaries from it" "cargo metadata --no-deps" 1
[ -n "$bins" ] || cli_fail "deploy.no_binaries" "the crates $crates have no binaries" "name crates that build a binary" "odapkit deploy <crate>" 2
for b in $bins; do cp "target/aarch64-unknown-linux-gnu/$profile/$b" "$stage/usr/lib/blackbird/"; done
# ID=_any: a development extension applies to whichever Blackbird OS image the device runs.
printf 'ID=_any\nARCHITECTURE=arm64\n' > "$stage/usr/lib/extension-release.d/extension-release.$name"

if [ -n "${ODAP_DEVICE_SSH:-}" ]; then remote="$ODAP_DEVICE_SSH"; else remote="$(repo_dir virtual-devices)/bin/odap-vdev ssh --"; fi
# No macOS metadata in the archive; the device keeps its own clock for file times.
# shellcheck disable=SC2086
COPYFILE_DISABLE=1 tar --no-mac-metadata --no-xattrs -C "$stage" -cf - usr | $remote "set -e
  d=/var/lib/extensions/$name
  rm -rf \$d.new && mkdir -p \$d.new
  if [ $keep = 1 ] && [ -d \$d ]; then cp -a \$d/. \$d.new/; fi
  tar -C \$d.new -m --no-same-owner -xf -
  systemd-sysext unmerge >/dev/null 2>&1 || true
  rm -rf \$d && mv \$d.new \$d
  sync
  systemd-sysext refresh
  for u in $restart; do systemctl restart \$u; done"
if [ "$CLI_JSON" = 1 ]; then result true; else echo "deployed $name: $crates"; fi
