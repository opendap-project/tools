#!/bin/sh
# odw render: a thin entry point; the engine, and its --help, is render/ (run as render/__main__.py; adapters in electronics/render and mechanical/render).
self="$(readlink -f "$0" 2>/dev/null || echo "$0")"
here="$(cd "$(dirname "$self")/.." && pwd)"
exec python3 "$here/render/__main__.py" "$@"
