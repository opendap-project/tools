{
  "meta": {
    "filename": "load-switch.kicad_pro",
    "version": 3
  },
  "erc": {
    "erc_exclusions": [],
    "meta": {
      "version": 0
    },
    "rule_severities": {
      "endpoint_off_grid": "error",
      "four_way_junction": "ignore",
      "pin_not_connected": "error",
      "label_dangling": "error",
      "hier_label_mismatch": "error",
      "power_pin_not_driven": "error",
      "unresolved_variable": "error",
      "unannotated": "error",
      "duplicate_reference": "error",
      "missing_power_pin": "error",
      "multiple_net_names": "error",
      "similar_labels": "error",
      "similar_power": "error",
      "similar_label_and_power": "error",
      "same_local_global_label": "error",
      "same_local_global_power": "error",
      "no_connect_connected": "error",
      "no_connect_dangling": "error",
      "wire_dangling": "error",
      "unconnected_wire_endpoint": "error",
      "pin_not_driven": "error",
      "undefined_netclass": "error",
      "ground_pin_not_ground": "error",
      "lib_symbol_issues": "warning",
      "lib_symbol_mismatch": "warning",
      "footprint_link_issues": "warning",
      "footprint_filter": "ignore",
      "single_global_label": "warning",
      "isolated_pin_label": "warning",
      "missing_input_pin": "warning",
      "missing_bidi_pin": "warning",
      "missing_unit": "warning",
      "net_not_bus_member": "warning",
      "pin_to_pin": "warning",
      "simulation_model_issue": "ignore",
      "bus_definition_conflict": "error",
      "bus_entry_needed": "error",
      "bus_to_bus_conflict": "error",
      "bus_to_net_conflict": "error",
      "different_unit_footprint": "error",
      "different_unit_net": "error",
      "duplicate_sheet_names": "error",
      "extra_units": "error",
      "label_multiple_wires": "warning",
      "unit_value_mismatch": "error",
      "stacked_pin_name": "warning",
      "field_name_whitespace": "warning"
    }
  },
  "schematic": {
    "page_layout_descr_file": "custom.kicad_wks",
    "connection_grid_size": 50.0,
    "annotate_start_num": 0,
    "drawing": {
      "default_text_size": 50.0,
      "default_line_thickness": 6.0,
      "default_wire_thickness": 6.0,
      "default_bus_thickness": 12.0,
      "default_junction_size": 40.0,
      "junction_size_choice": 3,
      "label_size_ratio": 0.3,
      "pin_symbol_size": 25.0,
      "text_offset_ratio": 0.3,
      "intersheets_ref_show": true,
      "intersheets_ref_short": false,
      "intersheets_ref_prefix": "[",
      "intersheets_ref_suffix": "]",
      "intersheets_ref_own_page": false,
      "field_names": [
        {
          "name": "Manufacturer",
          "url": false,
          "visible": false
        },
        {
          "name": "MPN",
          "url": false,
          "visible": false
        },
        {
          "name": "Spec",
          "url": false,
          "visible": true
        },
        {
          "name": "Block",
          "url": false,
          "visible": false
        },
        {
          "name": "Constraints",
          "url": false,
          "visible": false
        },
        {
          "name": "Manufacturer_2",
          "url": false,
          "visible": false
        },
        {
          "name": "MPN_2",
          "url": false,
          "visible": false
        },
        {
          "name": "Alternate",
          "url": false,
          "visible": false
        }
      ]
    },
    "meta": {
      "version": 1
    }
  },
  "net_settings": {
    "classes": [
      {
        "name": "Default",
        "priority": 2147483647,
        "wire_width": 6,
        "bus_width": 12,
        "clearance": 0.2,
        "track_width": 0.2,
        "via_diameter": 0.6,
        "via_drill": 0.3,
        "microvia_diameter": 0.3,
        "microvia_drill": 0.1,
        "diff_pair_width": 0.2,
        "diff_pair_gap": 0.25,
        "diff_pair_via_gap": 0.25,
        "line_style": 0,
        "pcb_color": "rgba(0, 0, 0, 0.000)",
        "schematic_color": "rgba(0, 0, 0, 0.000)"
      },
      {
        "name": "PWR_PERIPH",
        "priority": 0,
        "schematic_color": "rgba(0, 0, 0, 0.000)",
        "pcb_color": "rgba(0, 0, 0, 0.000)"
      },
      {
        "name": "EXTRA",
        "priority": 9
      }
    ],
    "meta": {
      "version": 4
    },
    "netclass_assignments": null,
    "netclass_patterns": [
      {
        "netclass": "PWR_PERIPH",
        "pattern": "PERIPH_3V3"
      }
    ]
  },
  "text_variables": {
    "OPENDAP_PROJECT": "OpenDAP example",
    "OPENDAP_BOARD": "load-switch block",
    "OPENDAP_LICENCE": "MIT"
  },
  "sheets": [],
  "libraries": {
    "pinned_footprint_libs": [],
    "pinned_symbol_libs": []
  }
}