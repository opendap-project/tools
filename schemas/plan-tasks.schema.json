{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/opendap-project/tools/blob/main/schemas/plan-tasks.schema.json",
  "title": "opendap.plan-tasks/v1: tasks of a programme, as odw plan list and next print them with --json",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema",
    "items"
  ],
  "properties": {
    "schema": {
      "const": "opendap.plan-tasks/v1"
    },
    "items": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "id",
          "phase",
          "title",
          "status"
        ],
        "properties": {
          "id": {
            "type": "string",
            "pattern": "^[A-Z][A-Z0-9]*-[0-9]{2,}$"
          },
          "phase": {
            "type": "integer"
          },
          "title": {
            "type": "string"
          },
          "status": {
            "enum": [
              "todo",
              "doing",
              "review",
              "done",
              "blocked",
              "decision",
              "dropped"
            ]
          }
        }
      }
    }
  }
}
