#!/bin/sh
# Inventory every command-line surface and check it against the command standard (§5, §8).
#
# Usage: odapkit cli list|check [--workspace DIR] [--root ROOT]... [--json]   (odapkit cli --help for all flags)
# Spec: docs/specs/cli-conformance.md.
here="$(cd "$(dirname "$(readlink -f "$0" 2>/dev/null || echo "$0")")/.." && pwd)"
exec uv run --quiet --project "$here" python -m odw.cli_conformance "$@"
