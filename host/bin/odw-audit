#!/bin/sh
# Workspace metrics measured from every repository's tracked files; dated snapshots and per-repository conformance.
#
# Usage: odw audit [--workspace DIR] [--rename-map TSV] [--write DIR] [--json]
# Spec: docs/specs/workspace-audit.md.
here="$(cd "$(dirname "$(readlink -f "$0" 2>/dev/null || echo "$0")")/.." && pwd)"
exec uv run --quiet --project "$here" python -m odw.audit "$@"
