#!/bin/sh
# Give virtual OpenDAP devices a NIC on this Mac's network (virtual-devices VD-003).
#
# Usage: odw vmnet [install|uninstall|status] [--dry-run] [--json]   (default: status)
#
# macOS bridges a VM to the LAN only through vmnet.framework, which needs root. socket_vmnet (Lima
# project) is the small root daemon that holds vmnet; QEMU connects to it as the user.
#
# install fetches the pinned upstream release of socket_vmnet, checks its SHA-256, unpacks it to
# /opt/socket_vmnet owned by root (upstream's binary install, the layout Lima expects), and runs it
# as a launchd daemon bridged to the interface of the default route (ODAP_LAN_INTERFACE overrides
# it). Run it as yourself or through sudo; as yourself it asks for your password only for the
# steps that need administrator rights, and only on a terminal: without one, sudo must not need a
# password (sudo -n) or the step fails. odap-vdev finds the daemon by its socket,
# /var/run/socket_vmnet.bridged.<interface>. install and uninstall take --dry-run: they name every
# step and run none. status --json prints opendap.vmnet-status/v1 (running, interface, socket).
#
# Examples:
#   odw vmnet status --json
#   odw vmnet install --dry-run
#
# Exit status: 0 success (status: running), 1 failure (status: not running), 2 usage error.
set -eu

here="$(cd "$(dirname "$0")/.." && pwd)"
CLI_TOOL="odw vmnet"
. "$here/lib/cli.sh"

verb=""; dry=0
for a in "$@"; do
  case "$a" in
    -h|--help) cli_help "$0" 22; exit 0 ;;
    --dry-run) dry=1 ;;
    --json) CLI_JSON=1 ;;
    -*) cli_usage "unknown flag $a" ;;
    install|uninstall|status) [ -z "$verb" ] || cli_usage "one command at a time: $verb, $a"; verb="$a" ;;
    *) cli_usage "unknown command $a (install, uninstall, status)" ;;
  esac
done
verb="${verb:-status}"

[ "$(uname -s)" = Darwin ] ||
  cli_fail "platform.unsupported" "macOS only" "on Linux, bridge a tap device instead" "ip tuntap help" 2

iface="${ODAP_LAN_INTERFACE:-$(route -n get default 2>/dev/null | awk '/interface:/{print $2}')}"
label="org.opendap.socket_vmnet.bridged.$iface"
plist="/Library/LaunchDaemons/$label.plist"
sock="/var/run/socket_vmnet.bridged.$iface"
log="/var/log/socket_vmnet.bridged.$iface.log"

# Privileged steps: directly when already root; through sudo otherwise, which may ask for a password
# only on a terminal (sudo -n elsewhere, so nothing waits for an answer that cannot come).
as_root() {
  if [ "$(id -u)" = 0 ]; then "$@"
  elif cli_interactive; then sudo "$@"
  else sudo -n "$@"; fi
}

# The pinned upstream release: https://github.com/lima-vm/socket_vmnet/releases
version=1.2.2
case "$(uname -m)" in
  arm64) sha256=c7bf62308fbcfdc29bdfb8373c9b1951f7ac2396446e4390919796a94972e6dc ;;
  x86_64) sha256=2968a82c97e692c2d36f87230152e8018e00589c1b598e8257775adfe83800a1 ;;
  *) cli_fail "platform.unsupported" "no socket_vmnet release for $(uname -m)" "socket_vmnet ships arm64 and x86_64" \
       "uname -m" 2 ;;
esac
bin=/opt/socket_vmnet/bin
release_url() { echo "https://github.com/lima-vm/socket_vmnet/releases/download/v$version/socket_vmnet-$version-$(uname -m).tar.gz"; }

install_binaries() {
  file="socket_vmnet-$version-$(uname -m).tar.gz"
  tmp="$(mktemp -d)"
  trap 'rm -rf "$tmp"' EXIT
  curl -fsSL -o "$tmp/$file" "$(release_url)" ||
    cli_fail "download.failed" "could not download $file" "check the network and the release URL" "curl -I $(release_url)"
  echo "$sha256  $tmp/$file" | shasum -a 256 -c -s ||
    cli_fail "download.checksum" "$file does not match its pinned SHA-256" "the download is not the pinned release" \
      "odw vmnet install"
  tar -xzf "$tmp/$file" -C "$tmp" ./opt/socket_vmnet
  if cmp -s "$tmp/opt/socket_vmnet/bin/socket_vmnet" "$bin/socket_vmnet" && cmp -s "$tmp/opt/socket_vmnet/bin/socket_vmnet_client" "$bin/socket_vmnet_client"; then
    return 0
  fi
  # Root checks and unpacks its own copy: never the user-writable file it would re-read.
  rtmp="$(as_root mktemp -d)" ||
    cli_fail "admin.denied" "administrator rights were not granted" "without a terminal, sudo must not need a password" \
      "sudo odw vmnet install"
  as_root cp "$tmp/$file" "$rtmp/$file"
  echo "$sha256  $rtmp/$file" | as_root shasum -a 256 -c -s \
    || { as_root rm -rf "$rtmp"; cli_fail "download.checksum" "$file does not match its pinned SHA-256" \
           "the copy root checked differs from the download" "odw vmnet install"; }
  as_root tar -xzf "$rtmp/$file" -C / ./opt/socket_vmnet
  as_root rm -rf "$rtmp"
  as_root chown -R root:wheel /opt/socket_vmnet
  echo "socket_vmnet $version installed in /opt/socket_vmnet" >&2
}

install_daemon() {
  [ -n "$iface" ] || cli_fail "vmnet.no_interface" "no default-route interface" "name the LAN interface" \
    "ODAP_LAN_INTERFACE=en0 odw vmnet install"
  [ "$(id -u)" = 0 ] || echo "Administrator rights are needed for /opt/socket_vmnet and the daemon:" >&2
  install_binaries
  as_root tee "$plist" >/dev/null <<PLIST
<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0"><dict>
  <key>Label</key><string>$label</string>
  <key>ProgramArguments</key><array>
    <string>$bin/socket_vmnet</string>
    <string>--vmnet-mode=bridged</string>
    <string>--vmnet-interface=$iface</string>
    <string>--socket-group=staff</string>
    <string>$sock</string>
  </array>
  <key>RunAtLoad</key><true/>
  <key>KeepAlive</key><true/>
  <key>StandardErrorPath</key><string>$log</string>
</dict></plist>
PLIST
  as_root chown root:wheel "$plist"
  as_root chmod 0644 "$plist"
  as_root launchctl bootout system "$plist" 2>/dev/null || true
  as_root launchctl bootstrap system "$plist"
  i=0
  while [ ! -S "$sock" ] && [ "$i" -lt 10 ]; do sleep 0.5; i=$((i + 1)); done
  [ -S "$sock" ] || cli_fail "vmnet.not_started" "socket_vmnet did not start" "its log says why" "sudo tail $log"
  echo "socket_vmnet bridged to $iface: $sock"
  echo "Restart a running virtual device to give it the LAN: odap-vdev stop && odap-vdev start" >&2
}

dry() { echo "odw vmnet: would $*" >&2; }

case "$verb" in
  install)
    if [ "$dry" = 1 ]; then
      [ -n "$iface" ] || cli_fail "vmnet.no_interface" "no default-route interface" "name the LAN interface" \
        "ODAP_LAN_INTERFACE=en0 odw vmnet install --dry-run"
      dry "download $(release_url) and check its SHA-256 $sha256"
      dry "unpack it to /opt/socket_vmnet as root, owned by root:wheel"
      dry "write $plist (bridged to $iface, socket $sock) and bootstrap it with launchctl as root"
    else install_daemon; fi ;;
  uninstall)
    if [ "$dry" = 1 ]; then
      dry "bootout $label and remove $plist and $sock as root (the binaries stay in /opt/socket_vmnet)"
    else
      as_root launchctl bootout system "$plist" 2>/dev/null || true
      as_root rm -f "$plist" "$sock"
      echo "removed $label (the binaries stay in /opt/socket_vmnet)" >&2
    fi ;;
  status)
    running=false; [ -S "$sock" ] && running=true
    if [ "$CLI_JSON" = 1 ]; then
      printf '{"schema": "opendap.vmnet-status/v1", "running": %s, "interface": %s, "socket": %s}\n' \
        "$running" "$(cli_json_str "$iface")" "$(cli_json_str "$sock")"
    elif [ "$running" = true ]; then echo "running: $sock"
    else echo "not running ($sock missing); to install: odw vmnet install"; fi
    [ "$running" = true ] || exit 1 ;;
esac
