{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/opendap-project/toolkit-host/blob/main/schemas/check-result.schema.json",
  "title": "opendap.check-result/v1: what any check, test runner or study reports",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema",
    "tool",
    "subject",
    "generated",
    "results"
  ],
  "properties": {
    "schema": {
      "const": "opendap.check-result/v1"
    },
    "tool": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "name"
      ],
      "properties": {
        "name": {
          "type": "string"
        },
        "version": {
          "type": "string"
        },
        "commit": {
          "type": "string",
          "pattern": "^[0-9a-f]{7,40}$"
        }
      }
    },
    "subject": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "repo"
      ],
      "properties": {
        "repo": {
          "type": "string"
        },
        "path": {
          "type": "string"
        },
        "commit": {
          "type": "string",
          "pattern": "^[0-9a-f]{7,40}$"
        },
        "variant": {
          "type": "string"
        }
      }
    },
    "generated": {
      "type": "string",
      "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}T"
    },
    "results": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "id",
          "verdict",
          "message"
        ],
        "properties": {
          "id": {
            "type": "string",
            "minLength": 1
          },
          "rule": {
            "type": "string"
          },
          "level": {
            "type": "string",
            "pattern": "^[QIVTCH][0-9]+$"
          },
          "verdict": {
            "enum": [
              "pass",
              "fail",
              "warn",
              "skip",
              "error",
              "info"
            ]
          },
          "message": {
            "type": "string",
            "minLength": 1
          },
          "value": {
            "type": [
              "number",
              "string",
              "boolean"
            ]
          },
          "limit": {
            "type": [
              "number",
              "string"
            ]
          },
          "margin": {
            "type": "number"
          },
          "unit": {
            "type": "string"
          },
          "verifies": {
            "type": "array",
            "items": {
              "type": "string",
              "pattern": "^[A-Z][A-Z0-9]*-[0-9]{3}$"
            }
          },
          "evidence": {
            "type": "array",
            "items": {
              "type": "string",
              "minLength": 1
            }
          },
          "location": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "path"
            ],
            "properties": {
              "path": {
                "type": "string"
              },
              "line": {
                "type": "integer",
                "minimum": 1
              }
            }
          }
        }
      }
    }
  }
}
