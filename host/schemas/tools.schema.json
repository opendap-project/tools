{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/opendap-project/tools/blob/main/host/schemas/tools.schema.json",
  "title": "Tools a root contributes to an umbrella command (tools.toml)",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema",
    "front",
    "tool"
  ],
  "properties": {
    "schema": {
      "const": "opendap.tools/v1"
    },
    "front": {
      "enum": [
        "opendap",
        "odw"
      ]
    },
    "tool": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "name",
          "summary",
          "entry",
          "audience",
          "stability"
        ],
        "properties": {
          "name": {
            "type": "string",
            "pattern": "^[a-z][a-z0-9-]*$"
          },
          "summary": {
            "type": "string",
            "minLength": 1,
            "maxLength": 100
          },
          "entry": {
            "type": "string",
            "minLength": 1
          },
          "audience": {
            "enum": [
              "maintainer",
              "developer",
              "user"
            ]
          },
          "stability": {
            "enum": [
              "internal",
              "preview",
              "stable",
              "deprecated"
            ]
          },
          "replaces": {
            "type": "string"
          },
          "probe": {
            "description": "The read-only calls whose --json output the conformance test parses: one call (the arguments after the entry), or a list of calls when the tool's scripts answer different calls; {root} is the folder of this tools.toml and {workspace} the workspace (command standard §8 item 5)",
            "oneOf": [
              {
                "type": "array",
                "minItems": 1,
                "items": {
                  "type": "string"
                },
                "contains": {
                  "const": "--json"
                }
              },
              {
                "type": "array",
                "minItems": 1,
                "items": {
                  "type": "array",
                  "minItems": 1,
                  "items": {
                    "type": "string"
                  },
                  "contains": {
                    "const": "--json"
                  }
                }
              }
            ]
          }
        }
      }
    }
  }
}
