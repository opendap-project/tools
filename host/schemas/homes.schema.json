{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/opendap-project/tools/blob/main/host/schemas/homes.schema.json",
  "title": "opendap.homes/v1: the rules a programme introduced and their permanent homes",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema"
  ],
  "properties": {
    "schema": {
      "const": "opendap.homes/v1"
    },
    "rule": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "id",
          "rule"
        ],
        "properties": {
          "id": {
            "type": "string",
            "pattern": "^[a-z][a-z0-9-]*$"
          },
          "rule": {
            "type": "string",
            "minLength": 1
          },
          "pending": {
            "type": "string",
            "pattern": "^D-[A-Z0-9-]+$",
            "description": "the decision the rule waits for"
          },
          "homes": {
            "type": "array",
            "items": {
              "type": "object",
              "additionalProperties": false,
              "required": [
                "path",
                "contains"
              ],
              "properties": {
                "path": {
                  "type": "string",
                  "minLength": 1,
                  "description": "workspace-relative"
                },
                "contains": {
                  "type": "string",
                  "minLength": 1,
                  "description": "a phrase the home states (case and spacing ignored)"
                }
              }
            }
          }
        }
      }
    }
  }
}
