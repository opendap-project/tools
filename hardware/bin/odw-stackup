#!/bin/sh
# Layer stack and impedance-controlled trace geometry of a PCB: a 2D quasi-static field solver.
#
# Usage: odw stackup stack    STACKUP.toml [--json]      layer table, thickness, distance checks
#        odw stackup design   STACKUP.toml [--only CLASS]... [--json]   widths/gaps for the targets
#        odw stackup check    STACKUP.toml [--only CLASS]... [--json] [--no-corners]
#        odw stackup validate [--json]                   solver against closed forms
#        odw stackup coupling STACKUP.toml [--json]      broadside coupling of [[coupling]] cases
#        odw stackup explore  EXPLORE.toml [--csv F]     enumerate and rank zoned stackups
#        odw stackup pdn      PDN.toml [--json]          plane pairing against a rail's target impedance
#
# Runs tools/stackup/stackup.py in the tools' environment: uv installs the pinned, hash-locked
# dependencies of tools/uv.lock (numpy, scipy, scikit-fem) on first use. Format and
# method: docs/specs/stackup-method.md.
#
# Examples:
#   odw stackup validate --json
#   odw stackup check board.stackup.toml --json
#
# Exit status: 0 pass, 1 a check failed, 2 usage or file error.
set -eu
self="$(readlink -f "$0" 2>/dev/null || echo "$0")"
here="$(cd "$(dirname "$self")/.." && pwd)"
CLI_TOOL="odw stackup"
. "$here/lib/cli.sh"
case "${1:-}" in
  -h|--help|help) cli_header "$self" 20; exit 0 ;;
  "") cli_header "$self" 20; exit 2 ;;
esac
command -v uv >/dev/null 2>&1 || cli_fail "tool.missing" "uv not found" "toolkit-host's setup installs it" \
  "\"\${ODAP_TOOLKIT_HOST_DIR:-<toolkit-host>}/setup.sh\""
exec uv run --quiet --locked --project "$here/tools" python "$here/tools/stackup/stackup.py" "$@"
