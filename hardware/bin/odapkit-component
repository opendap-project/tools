#!/bin/sh
# odapkit component: a thin entry point; the engine, and its --help, is tools/component/ (run as
# tools/component/__main__.py, a uv script that pins its dependencies).
self="$(readlink -f "$0" 2>/dev/null || echo "$0")"
here="$(cd "$(dirname "$self")/.." && pwd)"
exec uv run --quiet --script "$here/tools/component/__main__.py" "$@"
