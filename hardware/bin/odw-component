#!/bin/sh
# odw component: a thin entry point; the engine, and its --help, is tools/component/ (run as
# tools/component/__main__.py in the tools' environment: pyyaml and jsonschema, pinned in tools/uv.lock).
self="$(readlink -f "$0" 2>/dev/null || echo "$0")"
here="$(cd "$(dirname "$self")/.." && pwd)"
exec uv run --quiet --locked --project "$here/tools" python3 "$here/tools/component/__main__.py" "$@"
