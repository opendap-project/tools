#!/bin/sh
# Compose a KiCad project's .kicad_dru from its fab and product rule sources, or check it.
#
# Usage: odapkit dru compose [--stdout] MANIFEST...   write <project>.kicad_dru from <project>.dru.toml
#        odapkit dru check [--json] [MANIFEST...]     verify; no manifest = every *.dru.toml in the repo
#
# The implementation is toolkit-hooks' hooks/kicad-dru.py, the same script the kicad-dru-composed
# pre-commit hook runs, so the tool and the hook never disagree. toolkit-hooks is found as the
# sibling ../hooks of this checkout or through $OPENDAP_TOOLKIT_HOOKS.
#
# Exit status: 0 success, 1 a stale, missing or invalid composition, 2 usage error.
set -eu
self="$(readlink -f "$0" 2>/dev/null || echo "$0")"
here="$(cd "$(dirname "$self")/.." && pwd)"
hooks="${OPENDAP_TOOLKIT_HOOKS:-$here/../hooks}"
script="$hooks/hooks/kicad-dru.py"
case "${1:-}" in
  ""|-h|--help|help) sed -n '2,11p' "$self" | sed 's/^# \{0,1\}//'; [ -n "${1:-}" ] && exit 0 || exit 2 ;;
esac
[ -f "$script" ] || { echo "odapkit dru: toolkit-hooks not found (set OPENDAP_TOOLKIT_HOOKS)" >&2; exit 1; }
exec python3 "$script" "$@"
