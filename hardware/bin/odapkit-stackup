#!/bin/sh
# Layer stack and impedance-controlled trace geometry of a PCB: a 2D quasi-static field solver.
#
# Usage: odapkit stackup stack    STACKUP.toml [--json]      layer table, thickness, distance checks
#        odapkit stackup design   STACKUP.toml [--only CLASS]... [--json]   widths/gaps for the targets
#        odapkit stackup check    STACKUP.toml [--only CLASS]... [--json] [--no-corners]
#        odapkit stackup validate [--json]                   solver against closed forms
#        odapkit stackup coupling STACKUP.toml [--json]      broadside coupling of [[coupling]] cases
#        odapkit stackup explore  EXPLORE.toml [--csv F]     enumerate and rank zoned stackups
#        odapkit stackup pdn      PDN.toml [--json]          plane pairing against a rail's target impedance
#
# Runs tools/stackup/stackup.py in its own environment: uv installs the pinned, hash-locked
# dependencies of tools/stackup/uv.lock (numpy, scipy, scikit-fem) on first use. Format and
# method: docs/specs/stackup-method.md.
#
# Exit status: 0 pass, 1 a check failed, 2 usage or file error.
set -eu
self="$(readlink -f "$0" 2>/dev/null || echo "$0")"
here="$(cd "$(dirname "$self")/.." && pwd)"
case "${1:-}" in
  ""|-h|--help|help) sed -n '2,16p' "$self" | sed 's/^# \{0,1\}//'; [ -n "${1:-}" ] && exit 0 || exit 2 ;;
esac
command -v uv >/dev/null 2>&1 || { echo "odapkit stackup: uv not found (toolkit-host setup installs it)" >&2; exit 1; }
exec uv run --quiet --locked --project "$here/tools/stackup" python "$here/tools/stackup/stackup.py" "$@"
