{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/opendap-project/toolkit-hardware/blob/main/schemas/board-variant.schema.json",
  "title": "opendap.board-variant/v1",
  "description": "A board variant (RFC 0011 rule 7): one TOML file per variant, every block of the catalog once. Spec: docs/specs/variant-tool.md §2. The rules that need the catalog (blocks covered, alternates and params declared, promise) are checked by odapkit variant.",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema", "board", "name", "kind", "status", "target_level", "catalog", "blocks"],
  "properties": {
    "schema": {"const": "opendap.board-variant/v1"},
    "board": {"type": "string", "minLength": 1},
    "name": {"type": "string", "pattern": "^[a-z0-9][a-z0-9-]*$"},
    "kind": {"type": "string", "pattern": "^[a-z0-9][a-z0-9-]*$"},
    "status": {"enum": ["proposed", "accepted"]},
    "description": {"type": "string"},
    "target_level": {"type": "string", "pattern": "^Q[0-9]$"},
    "catalog": {"type": "string", "minLength": 1},
    "promise": {"type": "array", "items": {"type": "string", "pattern": "^[A-Z][A-Z0-9]*-[0-9]{2,}$"}},
    "instrumentation": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "links": {"enum": ["shunt", "zero-ohm"]},
        "test_points": {"const": "fit"}
      }
    },
    "blocks": {
      "type": "object",
      "propertyNames": {"pattern": "^blk\\.[a-z0-9][a-z0-9-]*$"},
      "additionalProperties": {
        "type": "object",
        "additionalProperties": false,
        "required": ["state"],
        "properties": {
          "state": {"enum": ["fit", "dnp", "alternate"]},
          "alternate": {"type": "string", "pattern": "^[a-z0-9][a-z0-9_.-]*$"},
          "params": {"type": "object"},
          "open": {"type": "string"},
          "note": {"type": "string"}
        },
        "if": {"properties": {"state": {"const": "alternate"}}},
        "then": {"required": ["alternate"]},
        "else": {"not": {"required": ["alternate"]}}
      }
    }
  }
}
