(kicad_wks (version 20231118) (generator "opendap-templates")
  (setup (textsize 1.5 1.5) (linewidth 0.15) (textlinewidth 0.15)
    (left_margin 10) (right_margin 10) (top_margin 10) (bottom_margin 10))
  (rect (name "frame") (start 0 0 ltcorner) (end 0 0 rbcorner) (linewidth 0.25))
  (rect (name "frame-inner") (start 4 4 ltcorner) (end 4 4 rbcorner) (linewidth 0.15))
  (line (name "zone-col-top") (start 50 0 ltcorner) (end 50 4 ltcorner) (repeat 30) (incrx 50))
  (line (name "zone-col-bottom") (start 50 0 lbcorner) (end 50 4 lbcorner) (repeat 30) (incrx 50))
  (tbtext "1" (name "zone-num-top") (pos 25 2 ltcorner) (font (size 1.5 1.5)) (justify center) (repeat 30) (incrx 50))
  (tbtext "1" (name "zone-num-bottom") (pos 25 2 lbcorner) (font (size 1.5 1.5)) (justify center) (repeat 30) (incrx 50))
  (line (name "zone-row-left") (start 0 50 ltcorner) (end 4 50 ltcorner) (repeat 30) (incry 50))
  (line (name "zone-row-right") (start 0 50 rtcorner) (end 4 50 rtcorner) (repeat 30) (incry 50))
  (tbtext "A" (name "zone-letter-left") (pos 2 25 ltcorner) (font (size 1.5 1.5)) (justify center) (repeat 30) (incry 50))
  (tbtext "A" (name "zone-letter-right") (pos 2 25 rtcorner) (font (size 1.5 1.5)) (justify center) (repeat 30) (incry 50))
  (rect (name "title-block") (start 134 36) (end 4 4) (linewidth 0.25))
  (line (name "tb-row-6") (start 134 10) (end 4 10) (linewidth 0.15))
  (line (name "tb-row-13") (start 134 17) (end 4 17) (linewidth 0.15))
  (line (name "tb-row-20") (start 134 24) (end 4 24) (linewidth 0.15))
  (line (name "tb-col-block") (start 42 36) (end 42 24) (linewidth 0.15))
  (tbtext "Title" (name "tb-l-title") (pos 132.4 34) (font (size 1 1)) (justify left))
  (tbtext "${TITLE}" (name "tb-title") (pos 132.4 28.5) (font bold (size 2.5 2.5)) (justify left) (maxlen 88.8))
  (tbtext "Block" (name "tb-l-block") (pos 40.4 34) (font (size 1 1)) (justify left))
  (tbtext "${COMMENT1}" (name "tb-block") (pos 40.4 28.5) (font (size 1.5 1.5)) (justify left) (maxlen 34.8))
  (tbtext "Purpose" (name "tb-l-purpose") (pos 132.4 22.2) (font (size 1 1)) (justify left))
  (tbtext "${COMMENT2}" (name "tb-purpose") (pos 132.4 19) (font (size 1.5 1.5)) (justify left) (maxlen 126.8))
  (tbtext "Project, board" (name "tb-l-0") (pos 132.4 15.2) (font (size 1 1)) (justify left))
  (tbtext "${OPENDAP_PROJECT}, ${OPENDAP_BOARD}" (name "tb-v-0") (pos 132.4 12) (font (size 1.5 1.5)) (justify left) (maxlen 40.8))
  (line (name "tb-col-1") (start 90 17) (end 90 10) (linewidth 0.15))
  (tbtext "Variant" (name "tb-l-1") (pos 88.4 15.2) (font (size 1 1)) (justify left))
  (tbtext "${VARIANT}" (name "tb-v-1") (pos 88.4 12) (font (size 1.5 1.5)) (justify left) (maxlen 20.8))
  (line (name "tb-col-2") (start 66 17) (end 66 10) (linewidth 0.15))
  (tbtext "Rev" (name "tb-l-2") (pos 64.4 15.2) (font (size 1 1)) (justify left))
  (tbtext "${REVISION}" (name "tb-v-2") (pos 64.4 12) (font (size 1.5 1.5)) (justify left) (maxlen 8.8))
  (line (name "tb-col-3") (start 54 17) (end 54 10) (linewidth 0.15))
  (tbtext "Date" (name "tb-l-3") (pos 52.4 15.2) (font (size 1 1)) (justify left))
  (tbtext "${ISSUE_DATE}" (name "tb-v-3") (pos 52.4 12) (font (size 1.5 1.5)) (justify left) (maxlen 20.8))
  (line (name "tb-col-4") (start 30 17) (end 30 10) (linewidth 0.15))
  (tbtext "Sheet" (name "tb-l-4") (pos 28.4 15.2) (font (size 1 1)) (justify left))
  (tbtext "${#} / ${##}" (name "tb-v-4") (pos 28.4 12) (font (size 1.5 1.5)) (justify left) (maxlen 22.8))
  (tbtext "© ${COMPANY} · ${OPENDAP_LICENCE} · ${OPENDAP_SOURCE}" (name "tb-terms") (pos 132.4 7) (font (size 1 1)) (justify left) (maxlen 90))
  (tbtext "${SHEETPATH}" (name "tb-path") (pos 5.6 7) (font (size 1 1)) (justify right) (maxlen 36))
)
